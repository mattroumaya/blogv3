---
import { Image, Font } from "astro:assets";
import me from "../assets/me-icecream.png";
---

<head>
  <Font cssVariable="--font-rubik-beastly" preload />
</head>
<style>
  h1 {
    font-family: var(--font-rubik-beastly);
    text-align: center;
  }
</style>
<div class="about">
  <h1>Matt Roumaya</h1>
  <p>
    I'm <b>Matt</b>, a Software Engineer based in Philadelphia.
    <br />
  </p>
  <Image
    class="about-img"
    src={me}
    alt="black and white photo of matt roumaya at philadelphia museum of art"
    width="400"
  />
</div>
